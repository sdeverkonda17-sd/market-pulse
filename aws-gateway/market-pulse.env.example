# Public dashboard origins allowed to call the gateway. Separate additional
# origins with commas.
DASHBOARD_ORIGINS=https://market-pulse-sd.netlify.app
PORT=8787

# Enter these values only in /etc/market-pulse/market-pulse.env on the AWS
# server. Never commit them, put them in the browser, or send them in chat.
SHAREKHAN_API_KEY=
SHAREKHAN_SECURE_KEY=
# Leave empty for a Self App / customer login.
SHAREKHAN_VENDOR_KEY=
